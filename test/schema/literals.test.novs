#^^^^^^ keyword.control.directive.nova
type Name = string @pattern("[A-Za-z(][)#A-Za-z0-9_-]*")  # name
#                  ^ punctuation.definition.attribute.nova-schema
#                   ^^^^^^^ entity.other.attribute-name.nova-schema
