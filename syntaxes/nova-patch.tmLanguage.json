{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NOVA Patch",
  "scopeName": "source.nova.patch",
  "fileTypes": [
    "nova-patch"
  ],
  "patterns": [
    {
      "include": "source.nova#comment"
    },
    {
      "include": "#patch-directive"
    },
    {
      "include": "source.nova#data-directives"
    },
    {
      "include": "#operation"
    },
    {
      "include": "#replace"
    },
    {
      "include": "source.nova#flow-value"
    }
  ],
  "repository": {
    "patch-directive": {
      "begin": "^(@)(patch)(?=\\s|$)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.directive.nova"
        },
        "2": {
          "name": "keyword.control.directive.patch.nova"
        }
      },
      "patterns": [
        {
          "include": "source.nova#comment"
        },
        {
          "match": "(?<=\\s)sha256:[0-9A-Fa-f]*",
          "name": "constant.other.revision.nova"
        },
        {
          "match": "(?<=\\s)([A-Za-z_][A-Za-z0-9_-]*)(@)([0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.+-]*)?)(?:(#)([0-9A-Fa-f]+))?",
          "captures": {
            "1": {
              "name": "entity.name.type.schema.nova"
            },
            "2": {
              "name": "punctuation.separator.version.nova"
            },
            "3": {
              "name": "constant.numeric.version.nova"
            },
            "4": {
              "name": "punctuation.separator.fingerprint.nova"
            },
            "5": {
              "name": "constant.other.fingerprint.nova"
            }
          }
        }
      ]
    },
    "operation": {
      "begin": "^([=+\\-?])(?=\\s)\\s*((?:[A-Za-z_][A-Za-z0-9_-]*|\"(?:[^\"\\\\]|\\\\.)*\"|\\[[^\\]\\n]*\\]|\\.)(?:\\.(?:[A-Za-z_][A-Za-z0-9_-]*|\"(?:[^\"\\\\]|\\\\.)*\")|\\[[^\\]\\n]*\\])*)(?:(:)(?=\\s|$))?",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.patch.nova"
        },
        "2": {
          "name": "meta.path.nova",
          "patterns": [
            {
              "include": "source.nova#path"
            }
          ]
        },
        "3": {
          "name": "punctuation.separator.key-value.nova"
        }
      },
      "name": "meta.patch.operation.nova",
      "patterns": [
        {
          "include": "source.nova#flow-value"
        }
      ]
    },
    "replace": {
      "begin": "^((?:[A-Za-z_][A-Za-z0-9_-]*|\"(?:[^\"\\\\]|\\\\.)*\"|\\[[^\\]\\n]*\\]|\\.)(?:\\.(?:[A-Za-z_][A-Za-z0-9_-]*|\"(?:[^\"\\\\]|\\\\.)*\")|\\[[^\\]\\n]*\\])*)(:)(?=\\s)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "meta.path.nova",
          "patterns": [
            {
              "include": "source.nova#path"
            }
          ]
        },
        "2": {
          "name": "punctuation.separator.key-value.nova"
        }
      },
      "name": "meta.patch.operation.replace.nova",
      "patterns": [
        {
          "match": "(?<=\\s)->(?=\\s|$)",
          "name": "keyword.operator.arrow.nova"
        },
        {
          "include": "source.nova#flow-value"
        }
      ]
    }
  }
}
