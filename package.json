{
  "name": "vscode-novafile",
  "displayName": "NOVA Notation for Objects, Values & Agents",
  "description": "Language support for NOVA (Notation for Objects, Values & Agents): documents, schemas (.novs), templates and patches, with syntax highlighting and the nvf-lsp language server.",
  "version": "0.1.0",
  "publisher": "novafile",
  "icon": "images/icon.png",
  "license": "(EUPL-1.2 OR MPL-2.0) AND Apache-2.0",
  "homepage": "https://novafile.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/novafile/vscode-novafile.git"
  },
  "bugs": {
    "url": "https://github.com/novafile/vscode-novafile/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "nova",
    "novafile",
    "nvf",
    "serialization",
    "schema",
    "configuration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:diff"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nova",
        "aliases": [
          "NOVA",
          "nova"
        ],
        "extensions": [
          ".nova"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nova-patch",
        "aliases": [
          "NOVA Patch",
          "nova-patch"
        ],
        "extensions": [
          ".nova-patch",
          ".novapatch"
        ],
        "firstLine": "^@patch(\\s|$)",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nova-schema",
        "aliases": [
          "NOVA Schema",
          "nova-schema"
        ],
        "extensions": [
          ".novs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nova",
        "scopeName": "source.nova",
        "path": "./syntaxes/nova.tmLanguage.json"
      },
      {
        "language": "nova-patch",
        "scopeName": "source.nova.patch",
        "path": "./syntaxes/nova-patch.tmLanguage.json"
      },
      {
        "language": "nova-schema",
        "scopeName": "source.nova.schema",
        "path": "./syntaxes/nova-schema.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "novafile.restartServer",
        "title": "Restart Language Server",
        "category": "NOVA"
      },
      {
        "command": "novafile.showOutput",
        "title": "Show Language Server Output",
        "category": "NOVA"
      }
    ],
    "configuration": {
      "title": "NOVA",
      "properties": {
        "novafile.server.path": {
          "type": "string",
          "default": "nvf-lsp",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `nvf-lsp` language server binary. A bare name is looked up on `PATH`. Install it with `cargo install novafile-lsp`."
        },
        "novafile.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Extra command-line arguments passed to the language server."
        },
        "novafile.server.enable": {
          "type": "boolean",
          "default": true,
          "description": "Start the nvf-lsp language server. Disable to keep syntax highlighting only."
        },
        "novafile.patch.detectByContent": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Switch `.patch` files whose first non-comment line is `@patch` from the Diff language to **NOVA Patch**."
        },
        "novafile.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the NOVA language server."
        }
      }
    },
    "configurationDefaults": {
      "[nova]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.autoIndent": "advanced"
      },
      "[nova-patch]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.autoIndent": "advanced"
      },
      "[nova-schema]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.autoIndent": "advanced"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn compile:prod",
    "compile": "yarn typecheck && node esbuild.mjs",
    "compile:prod": "yarn typecheck && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "yarn test:grammar",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/nova.tmLanguage.json -g syntaxes/nova-patch.tmLanguage.json -g syntaxes/nova-schema.tmLanguage.json \"test/**/*.test.*\"",
    "package": "vsce package --no-dependencies",
    "build:grammars": "node scripts/build-grammars.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.82.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
